  <link name="gripper_base">
      <visual>
        <geometry>
            <!--- 0.0 0 -0.04 -->
            <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_base.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz = "-0.02 0.012 -0.018 " rpy = " 0 0 1.5708"/>
      </visual>
      <collision>
        <geometry>
            <!--- 0.0 0 -0.04 -->
            <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_base.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz = "-0.02 0.012 -0.018 " rpy = " 0 0 1.5708"/>
      </collision>
  </link>

    <link name="gripper_left1">
        <visual>
            <geometry>
                <!--- 0.0 0 -0.04 -->
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_left1.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "0.036 -0.052 0.0 " rpy = " 0 0 1.5708"/>
            <!-- <material name="half_transparent">
                <color rgba="0.9 0.8 0.8 0.8"/>
            </material> -->
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_left1.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "0.036 -0.052 0.0 " rpy = " 0 0 1.5708"/>
        </collision>
    </link>

    <link name="gripper_left2">
        <visual>
            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_left2.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "0.03 0.024 -0.018 " rpy = " 0 0 1.5708"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_left2.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "0.03 0.024 -0.018 " rpy = " 0 0 1.5708"/>
