    <origin xyz = "0.0 0.0 -0.078 " rpy = " 0 0 1.5708"/>
    </visual>
    <collision>
     <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/link1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz = "0.0 0.0 -0.078 " rpy = " 0 0 1.5708"/>
    </collision>
  </link>


