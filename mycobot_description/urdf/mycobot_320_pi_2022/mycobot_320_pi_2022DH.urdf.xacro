        <visual>
            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_left3.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "0.034 0.0 -0.012 " rpy = " 0 3.14159 -1.5708"/>
            <!-- <origin xyz = "0.0 0 0 " rpy = " 0 0 0"/> -->

        </visual>
        <collision>
            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_left3.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "0.034 0.0 -0.012 " rpy = " 0 3.14159 -1.5708"/>
        </collision>
