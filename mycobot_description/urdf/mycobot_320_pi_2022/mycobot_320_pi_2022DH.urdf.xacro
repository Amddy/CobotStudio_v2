<?xml version="1.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="firefighter" >
	
<xacro:property name="width" value=".2" />
  <xacro:arg name="gripper_align" default="false"/>

  <link name="base_mesa">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/base_mesa.STL" scale="0.001 0.001 0.001"/>
      </geometry>
	<!---<origin xyz="0.0653 0.005 -0.015" rpy="-1.5708 0 -3.17929"/>-->
	<origin xyz="0.05 0.0 -0.02425" rpy="-1.57 0.0 -3.14"/>
	<material name="alum">
      <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/base_mesa.STL" scale="0.001 0.001 0.001"/>
      </geometry>
	  <origin xyz="0.05 0.0 -0.02425" rpy="-1.57 0.0 -3.14"/>
    </collision>
  </link>

  <link name="base_flange">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/base_flange.STL" scale="0.001 0.001 0.001"/>
      </geometry>
	<origin xyz="-0.1307287 0.0 -0.0075" rpy="1.5708 0 1.5708"/>
	<material name="mycobot_grey">
      <color rgba="0.576 0.576 0.576 1.0"/>
    </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/base_flange.STL" scale="0.001 0.001 0.001"/>
      </geometry>
	  <origin xyz="-0.1307287 0.0 -0.0075" rpy="1.5708 0 1.5708"/>
    </collision>
  </link>

  
  <link name="base">
    <visual>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
       <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/base.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    <origin xyz = "0.0 0 0 " rpy = " 0 0 3.14159"/>
    </visual>
    <collision>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
       <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/base.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz = "0.0 0 0 " rpy = " 0 0 3.14159"/>
    </collision>
  </link>

