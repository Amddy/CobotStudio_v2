            <geometry>
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_right2.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "-0.066 0.023 -0.018 " rpy = " 0 0 1.5708"/>
        </visual>
