       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/link6.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    <origin xyz = "0.0 0.0 -0.0115 " rpy = " 1.5708 1.5708 0"/>
