                <!--- 0.0 0 -0.04 -->
                <mesh filename="package://mycobot_description/urdf/mycobot_320_pi_2022/gripper_right1.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz = "-0.072 -0.05 0.0 " rpy = " 0 0 1.5708"/>
        </visual>
